# Variables shared by the three client scripts in this directory:
#   client_multi_server.py        — 1 client -> N servers
#   client_multi_session.py       — 1 device -> N concurrent sessions toward 1 server
#   client_agent_multi_server.py  — 1 client (itself an ADK agent) -> N servers
# Change only KEY_PROVIDER_NAME to test base / pqc / arqit_py without
# touching the code.
#
# Copy to .env and fill in GOOGLE_API_KEY.

KEY_PROVIDER_NAME=pqc

# --- used by client_multi_server.py and client_agent_multi_server.py
#     (both servers together) ---
BASE_URL_1=http://localhost:8101/agents/server-ms-1
BASE_URL_2=http://localhost:8102/agents/server-ms-2

# Only relevant for KEY_PROVIDER_NAME=arqit_py: a different device
# identity per server, passed to SecureSessionManager via
# arqit_client_configs={base_url: config_path}. Absolute paths so they
# are independent of the launch cwd.
ARQIT_PY_CLIENT_CONFIG_1=/absolute/path/to/samples/client/10_client_ms/aq-sf-client-ms-1.json
ARQIT_PY_CLIENT_CONFIG_2=/absolute/path/to/samples/client/10_client_ms/aq-sf-client-ms-2.json

# --- used by client_multi_session.py (one server/device at a time) ---
# Default: device ms-1 against server_ms_1. For the second device/
# server, override the 3 variables below at launch time (see README.md):
#   BASE_URL=http://localhost:8102 AGENT_PATH=/agents/server-ms-2 \
#   ARQIT_PY_CLIENT_CONFIG=.../aq-sf-client-ms-2.json python client_multi_session.py
BASE_URL=http://localhost:8101
AGENT_PATH=/agents/server-ms-1
ARQIT_PY_CLIENT_CONFIG=/absolute/path/to/samples/client/10_client_ms/aq-sf-client-ms-1.json

# optional, defaults shown — only used by client_multi_session.py:
GROUP_SIZE=3
NUM_GROUPS=2

ARQIT_PY_TRANSPORT=socket

# client_agent_multi_server.py (the client is itself an ADK agent, so it
# needs its own Gemini key — can be the same one used by the servers).
GOOGLE_API_KEY=
