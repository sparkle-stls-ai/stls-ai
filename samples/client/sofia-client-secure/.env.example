# ── Mode ──────────────────────────────────────────────────────────────────────
# VITE_MODE: 'debug' keeps the original dev UI with manual agent URL.
# 'production' activates the production UI (agent dropdown, auth, DB).
VITE_MODE=production

# ── Authentication (only used when VITE_MODE=production) ──────────────────────
# VITE_AUTH_MODE options:
#   none  → no login required; all agents in sf_agents_config are accessible
#           (anyone reaching the URL can use them: only behind another auth layer / internal network)
#   app   → app-to-app auth (external app calls /api/auth/app-login to get token)
#   user  → user/password login form
VITE_AUTH_MODE=none

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session (required when VITE_MODE=production and VITE_AUTH_MODE != none) ──
SESSION_SECRET=replace-this-with-a-long-random-string
SESSION_TIMEOUT_MINUTES=30

# Space-separated origins allowed to embed this app in an <iframe>
# (CSP frame-ancestors). Leave empty (default) to allow ANY site to embed
# the app — convenient while onboarding integrators, but with no
# clickjacking protection. Set it to the known integrator domain(s) once
# stable (see server/src/middleware/securityHeaders.ts for the tradeoff).
# Needed for the Salesforce/BCAME Customer Portal iframe integration —
# the session there is carried via Authorization: Bearer <sessionToken>
# (from /api/auth/exchange) instead of the sofia.sid cookie, since that
# cookie can't survive a cross-site iframe. See server/src/middleware/
# bearerAuth.ts and src/api/apiFetch.ts.
# e.g. FRAME_ANCESTORS=https://bcame-portal.my.site.com https://*.force.com
FRAME_ANCESTORS=

# ── PostgreSQL (required when VITE_MODE=production) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sofia
DB_USER=postgres
DB_PASSWORD=

# ── Python secure transport service ───────────────────────────────────────────
# URL at which the Express backend reaches the Python service.
# In Docker (same container) or local dev: http://localhost:8090
SECURE_TRANSPORT_URL=http://localhost:8090

# Bind address for the Python service itself (secure_transport.py reads these).
SECURE_TRANSPORT_PORT=8090
SECURE_TRANSPORT_HOST=0.0.0.0

# ── Key session provider (stls_a2a) ───────────────────────────────────────────
KEY_SESSION_PORT=8081         # port of the base/arqit_py key-session sidecar
KEY_SESSION_HOST=localhost    # host of the key-exchange sidecar
KEY_PROVIDER_NAME=pqc        # base | arqit_py | pqc

# ── Arqit SKA-Platform (only when KEY_PROVIDER_NAME=arqit_py) ────────────────
# ARQIT_PY_CLIENT_CONFIG=/path/to/client-config.json
# ARQIT_PY_SERVER_CONFIG=/path/to/server-config.json

# ── Key session store ───────────────────────────────────────────────────────────
# secure_transport.py stores key sessions (kid, key material) using the same
# SESSION_CACHE_* convention as the server-side stls_core.SessionCacheFactory.
# "memory" (default) does not survive process restarts or multi-instance
# deployments; switch to "redis" on Cloud Run, where a session started on one
# request can be resolved by a different container instance on the next one.
SESSION_CACHE_BACKEND=memory          # memory (default) | redis
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc # Redis key prefix, distinct from stls:ks:*
SESSION_CACHE_TTL=3600                # idle timeout, seconds (sliding window)

# ── Post-quantum key exchange (only when KEY_PROVIDER_NAME=pqc) ───────────────
# Hybrid X25519 + ML-KEM-768 handshake, performed lazily on the first
# /secure/send or /secure/stream call. Requires liboqs-python, installed via
# the stls_a2a[pqc] extra in python/requirements.txt, and the liboqs C
# library baked into the image (see ARG LIBOQS_VERSION in the Dockerfile).

# ── Suggested follow-up actions (Gemini) ─────────────────────────────────────
# Chips under the agent's last response, generated from the response text only.
# Vertex AI: GOOGLE_GENAI_USE_VERTEXAI=true + project/location (uses ADC:
#   `gcloud auth application-default login` locally, service account in cloud).
# Quick local tests: GOOGLE_GENAI_USE_VERTEXAI=false + GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY=
# Defaults to AGENT_MODEL, then gemini-3.5-flash
SUGGESTIONS_MODEL=
