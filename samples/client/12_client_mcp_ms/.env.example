KEY_PROVIDER_NAME=pqc

# --- client_multi_server.ts (both servers together) ---
BASE_URL_1=http://localhost:8211
BASE_URL_2=http://localhost:8212

# Only relevant for KEY_PROVIDER_NAME=arqit_py: a different device
# identity per server, passed to KeySessionResolver via targetConfigs.
# Also needs ARQIT_SIDECAR_SOCKET_CLIENT pointing at an already-running
# Python sidecar process for the CLIENT role (see the README).
ARQIT_PY_CLIENT_CONFIG_1=/absolute/path/to/samples/client/12_client_mcp_ms/aq-sf-node-mcp-client-ms-1.json
ARQIT_PY_CLIENT_CONFIG_2=/absolute/path/to/samples/client/12_client_mcp_ms/aq-sf-node-mcp-client-ms-2.json
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-node-mcp-client-ms.sock

# --- client_multi_session.ts (one server/device at a time) ---
BASE_URL=http://localhost:8211
TOOL_NAME=ping_server_mcp_ms_1_node
ARQIT_PY_CLIENT_CONFIG=/absolute/path/to/samples/client/12_client_mcp_ms/aq-sf-node-mcp-client-ms-1.json

# optional, defaults shown — only used by client_multi_session.ts:
GROUP_SIZE=3
NUM_GROUPS=2
