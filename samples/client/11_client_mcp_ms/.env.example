# Client of the "1 client -> N MCP servers" test (see
# client_multi_server.py). Change only KEY_PROVIDER_NAME to test base /
# pqc / arqit_py without touching the code.
#
# Copy to .env and fill in GOOGLE_API_KEY.

KEY_PROVIDER_NAME=pqc

BASE_URL_1=http://localhost:8201
BASE_URL_2=http://localhost:8202

# Only relevant for KEY_PROVIDER_NAME=arqit_py: a different device
# identity per server, passed to SecureToolsetManager via
# arqit_client_configs={base_url: config_path}. Absolute paths so they
# are independent of the launch cwd.
ARQIT_PY_CLIENT_CONFIG_1=/absolute/path/to/samples/client/11_client_mcp_ms/aq-sf-mcp-client-ms-1.json
ARQIT_PY_CLIENT_CONFIG_2=/absolute/path/to/samples/client/11_client_mcp_ms/aq-sf-mcp-client-ms-2.json
ARQIT_PY_TRANSPORT=socket

# The client is itself an ADK agent, so it needs its own Gemini key —
# can be the same one used by the servers.
GOOGLE_API_KEY=
