KEY_PROVIDER_NAME=pqc
BASE_URL=http://localhost:8301

# Only needed for KEY_PROVIDER_NAME=arqit_py — see the server's
# .env.example for the device-reuse rationale (same pair, client side:
# sf-node-mcp-client-ms-1).
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-13-client-core.sock
ARQIT_SIDECAR_TOKEN_CLIENT=some-shared-secret
ARQIT_PY_CLIENT_CONFIG=/absolute/path/to/samples/client/12_client_mcp_ms/aq-sf-node-mcp-client-ms-1.json
