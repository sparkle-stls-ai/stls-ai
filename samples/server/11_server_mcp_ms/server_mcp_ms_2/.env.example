# server_mcp_ms_2 — the other of the two MCP server/client pairs in
# the multi-server test. Change only KEY_PROVIDER_NAME to test base /
# pqc / arqit_py: the rest of this file (ARQIT_PY_*) is only read when
# it's actually needed.
#
# Copy to .env.

KEY_PROVIDER_NAME=pqc

PORT=8202
SERVER_LABEL=server-mcp-ms-2
MCP_PLAIN_PATH=/mcp
MCP_STLS_PATH=/mcp-stls

# Only needed for KEY_PROVIDER_NAME=arqit_py. Absolute path so it is
# independent of the launch cwd (the config itself points at relative
# metadata/policy files, resolved against server.py's cwd, which it
# anchors to its own directory — see server.py).
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/samples/server/11_server_mcp_ms/server_mcp_ms_2/aq-sf-mcp-server-ms-2.json
ARQIT_PY_TRANSPORT=socket
