# server_consumer_2 — one of two replicas sharing the ONE device owned
# by ../device_agent/. ARQIT_PY_DEVICE_ROLE=consumer means this process
# never authenticates the device itself (see issue #38) — it only
# resolves keys ../device_agent/ already negotiated, via the shared
# Redis-backed store below.
#
# Copy to .env and fill in GOOGLE_API_KEY.

KEY_PROVIDER_NAME=arqit_py
ARQIT_PY_DEVICE_ROLE=consumer

PORT=8112
BASE_URL=http://localhost:8112
AGENT_PATH=/agents/server-consumer-2/secure-a2a
SERVER_LABEL=server-consumer-2

# No ARQIT_PY_SERVER_CONFIG here on purpose — a consumer never
# authenticates the device, so it never needs the device's own config
# file at all (see create_consumer_session() in stls_core_providers_arqit_py.py).

# MUST match ../device_agent/.env exactly — this is how this replica
# ends up reading the SAME device's keys.
KEY_STORE_BACKEND=redis
KEY_STORE_REDIS_URL=redis://localhost:6379
KEY_STORE_REDIS_NAMESPACE=device-agent-demo

# Only needed when KEY_PROVIDER_NAME=pqc or base is paired with ADK
# agents that call Gemini. Still read by this sample's agent.py even
# though the provider here is arqit_py, same as every other sample.
GOOGLE_API_KEY=
