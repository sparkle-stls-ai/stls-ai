# device_agent — owns the ONE Arqit device identity shared by both
# server_consumer_1 and server_consumer_2 below. This directory has no
# agent.py/server.py of its own: it just launches
# python/stls-core/sidecar/arqit_device_agent.py directly against this
# .env (copy it to .env and fill in the device config path) — see this
# sample's own README for the exact command.
#
# ARQIT_PY_DEVICE_ROLE is irrelevant here on purpose: this script
# always owns the device regardless of that env var's value (it never
# goes through KeySessionProviderFactory) — see
# arqit_device_agent.py's own docstring.

# Absolute path to YOUR OWN already-provisioned device's server config
# JSON (never a path from another sample — a device identity here is
# meant to be used by exactly one owner at a time, see issue #38's
# device-level owner lock).
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/your/device-server.json
ARQIT_PY_TRANSPORT=socket

# MUST be "redis", and MUST be the SAME value + namespace as both
# server_consumer_1/.env and server_consumer_2/.env below — this is
# how they end up reading the keys this process negotiates.
KEY_STORE_BACKEND=redis
KEY_STORE_REDIS_URL=redis://localhost:6379
KEY_STORE_REDIS_NAMESPACE=device-agent-demo

# K8s liveness/readiness probe port — see arqit_device_agent.py's own
# docstring for what /healthz and /livez mean.
DEVICE_AGENT_HEALTH_PORT=8080
