# Copy to .env and fill in Google credentials.

KEY_PROVIDER_NAME=base        # base | arqit_py | pqc — base needs no key-exchange sidecar

# ── Google Gemini ───────────────────────────────────────────────────────────
# Used by the ADK LlmAgent (adk_agents.py, model=AGENT_MODEL).
# Vertex AI: GOOGLE_GENAI_USE_VERTEXAI=true + project/location (uses ADC:
#   `gcloud auth application-default login` locally, service account in cloud).
# Gemini API: GOOGLE_GENAI_USE_VERTEXAI=false + GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.5-flash
