KEY_PROVIDER_NAME=pqc

PORT=8212
SERVER_LABEL=server-mcp-ms-2-node
MCP_PLAIN_PATH=/mcp
MCP_STLS_PATH=/mcp-stls

# Only needed for KEY_PROVIDER_NAME=arqit_py, and read by the Python
# sidecar process (launched separately — see the README), not by this
# script directly. ARQIT_SIDECAR_TOKEN_SERVER must match the token that
# sidecar process was started with (required — #17/#18 local socket
# authentication).
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-node-mcp-server-ms-2.sock
ARQIT_SIDECAR_TOKEN_SERVER=some-shared-secret-2
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/samples/server/12_server_mcp_ms/server_mcp_ms_2/aq-sf-node-mcp-server-ms-2.json
