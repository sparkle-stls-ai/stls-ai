 =============================================================================
# .env per sofia_identity_agent (agent_identity.py / tools_identity.py)
# =============================================================================
# Sottoinsieme scoped di .env.example (il file completo del package
# stls-identity) — solo le variabili che questo agente legge davvero.
# Per lo status list, il DID store e il Trust Anchor Registry con tutte
# le opzioni disponibili, vedi .env.example.
# =============================================================================

# ── Governing Authority — identità dell'emittente (tools_identity.py) ───────────
GOVERNING_AUTHORITY_DID=did:web:sofia.sparkle.example.com
GOVERNING_AUTHORITY_HOST=sofia.sparkle.example.com

# agent_id sotto cui è salvato il DID Document della Governing Authority
# stessa nel DID store — bootstrap_signing_key() lo usa per la chiave di firma
GOVERNING_AUTHORITY_AGENT_ID=governing-authority

# authority_id sotto cui è cachata la status list di revoca (Redis) — deve
# corrispondere a quello con cui verrà pubblicato lo StatusListCredential
IDENTITY_AUTHORITY_ID=sofia-authority

# URL pubblico dove verrà pubblicato lo StatusListCredential — va dentro
# ogni CredentialStatus.status_list_credential emesso da issue_identity_credential_for_agent
STATUS_LIST_PUBLISH_URL=https://sofia.sparkle.example.com/identity/status-list


# ── Identity Keystore — persistenza della chiave di firma Ed25519 ───────────────
# NON è lo stesso store di ArqitKeyStoreBase (stls-core): quella è per
# chiavi di sessione effimere con TTL, questa è per la chiave di firma
# dell'agente/authority, persistente, senza scadenza.

# "memory" (dev/test — non sopravvive al restart) | "redis" (persistente, consigliato per sofia-admin)
IDENTITY_KEYSTORE_BACKEND=redis

# Usate solo se IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey


# ── Status List + Credential Cache ───────────────────────────────────────────────
# Stessa connessione Redis per entrambi (status_list_manager e la cache
# delle credenziali dell'agente — cache_own_identity_credential,
# cache_operational_credential, ecc.) — nessuna variabile separata:
# stesso perimetro di fiducia, nessuna connessione aggiuntiva da configurare.
STATUS_LIST_REDIS_URL=redis://localhost:6379


# ── Postgres — DID Document store ────────────────────────────────────────────────
# Può puntare allo stesso database "sofia" già usato da AUTH_PG_DSN — è una
# tabella separata (SF_API_KEYS_TABLE/SF_AGENTS_TABLE non c'entrano), non
# serve un database dedicato. La tabella si crea da sola al primo avvio
# dell'agente (CREATE TABLE IF NOT EXISTS), nessuna migrazione manuale.
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
IDENTITY_PG_DID_TABLE=sf_identity_did_documents
IDENTITY_PG_CREDENTIAL_LOG_TABLE=sf_identity_credential_log
# ── Trust Anchor Registry — Authority esterne riconosciute dalla federazione ─────
# Stessa tabella che run_trust_registry.py espone via HTTP in sola lettura —
# onboard_trust_anchor/list_trust_anchors/revoke_trust_anchor scrivono qui.
TRUST_REGISTRY_PG_TABLE=sf_identity_trust_anchors


# ── Redis (condiviso con keystore, status list e credential cache sopra) ────────
REDIS_URL=redis://localhost:6379
# Redis con autenticazione:
# REDIS_URL=redis://:mypassword@localhost:6379/0


# ── Google Key (ADK, modello gemini-2.5-flash) ───────────────────────────────────
GOOGLE_API_KEY=

