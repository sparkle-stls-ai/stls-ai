# =============================================================================
# .env.trust_registry — configurazione per run_trust_registry.py
# =============================================================================
# File dedicato, separato da .env.identity_agent e .env.identity_bridge —
# tre processi indipendenti anche se girano nello stesso repo/directory.
# =============================================================================

# ── Postgres — stesso database "sofia" degli altri due processi ─────────────────
# È la STESSA tabella che agent_identity.py scrive con onboard_trust_anchor/
# revoke_trust_anchor — questo processo la legge soltanto, non scrive mai.
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
TRUST_REGISTRY_PG_TABLE=sf_identity_trust_anchors


# ── Server HTTP ────────────────────────────────────────────────────────────────
# Porta diversa dall'identity bridge (8000) — sono due servizi distinti,
# esposti separatamente ad altre piattaforme federate.
TRUST_REGISTRY_PORT=8100