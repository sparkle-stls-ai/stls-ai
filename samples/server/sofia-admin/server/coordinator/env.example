# =============================================================================
# .env for the coordinator (agent_coordinator.py / server.py)
# =============================================================================
# No example file existed for this service before issue #45 — created
# now, same placeholder style as identity_manager/env.example (no real
# secrets). Covers every variable this service already reads, not just
# the new ones.
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8010
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth Loader Backend ──────────────────────────────────────────────────────
AUTH_LOADER_BACKEND=postgres       # static | file | postgres

# ── PostgresLoader ───────────────────────────────────────────────────────────
# Leave empty to disable Postgres
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents       # default
SF_HEARTBEAT_INTERVAL=120       # 2 minutes
SF_LIVENESS_THRESHOLD=360       # 3x heartbeat = offline if missed for 6 min

# ── Redis (cache for every loader) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:mypassword@localhost:6379/0
AUTH_KM_USE_REDIS=true

# ── TTL and refresh ──────────────────────────────────────────────────────────
AUTH_KEY_TTL=3600
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REFRESH_INTERVAL=300

# ── LLM ────────────────────────────────────────────────────────────────────
AGENT_MODEL="gemini-3.5-flash"
OPENAI_API_KEY=
GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=eu
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── Arqit Sparkle SKA / session provider ────────────────────────────────────
KEY_SESSION_PORT=8081         # base | arqit_py | pqc
KEY_PROVIDER_NAME=pqc
# ARQIT_CLIENT_CONFIG=
# ARQIT_SERVER_CONFIG=

# ── Coordinator's sub-agents (port + API key for each) ──────────────────────
BASE_URL_REDIS="http://localhost:8013"
API_KEY_REDIS=""

BASE_URL_API_KEYS="http://localhost:8012"
API_KEY_API_KEYS=""

BASE_URL_MONITORING="http://localhost:8011"
API_KEY_MONITORING=""

# issue #45 — identity_manager, the 4th sub-agent (port from identity_manager/.env)
BASE_URL_IDENTITY="http://localhost:8014"
API_KEY_IDENTITY=""

# issue #45 — the coordinator's own identity, resolved dynamically from
# the same keystore and the same Redis credential cache as
# identity_manager/.env (see agent_coordinator.py:_load_coordinator_presenter)
# — NOT a local file. These values must match identity_manager/.env
# exactly: same Redis, same namespace.
GOVERNING_AUTHORITY_HOST=sofia.sparkle.example.com
IDENTITY_AGENT_ID=sofia-admin-coordinator
IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey
STATUS_LIST_REDIS_URL=redis://localhost:6379
