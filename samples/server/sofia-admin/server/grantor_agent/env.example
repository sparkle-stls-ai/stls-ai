# =============================================================================
# .env for the Grantor agent (agent_grantor.py / tools_delegation.py / server.py)
# =============================================================================
# One running copy of this service IS one specific Grantor — issue #51.
# Generic code, configured entirely via env vars below; which real-world
# authority it represents (a facility, a network segment, ...) is a
# deployment decision, not something hardcoded here. Deploy a second
# instance of this SAME code with a different IDENTITY_AGENT_ID (and a
# different PORT/API key) for each distinct Grantor you need.
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8016
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth Loader Backend — protects THIS agent's own endpoint ────────────────
# Independent of identity_manager's own access control: "can present a
# valid API key for sofia-grantor" IS the authorization check for acting
# as THIS specific Grantor (issue #51's resolved design).
AUTH_LOADER_BACKEND=postgres       # static | file | postgres
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents
SF_HEARTBEAT_INTERVAL=120
SF_LIVENESS_THRESHOLD=360

# ── Redis (cache for the loader above) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
AUTH_KM_USE_REDIS=true
AUTH_KEY_TTL=3600
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REFRESH_INTERVAL=300

# ── LLM ────────────────────────────────────────────────────────────────────
AGENT_MODEL="gemini-3.5-flash"
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── a2a secure provider ──────────────────────────────────────────────────────
KEY_SESSION_PORT=8081
KEY_PROVIDER_NAME=pqc


# =============================================================================
# This Grantor's own identity (issue #51) — must already be provisioned
# by identity_manager/bootstrap_grantor_agent_identity.py before this
# service can do anything useful (load_delegation_manager() returns None
# otherwise, and the server refuses the first delegate_to_agent() call).
# =============================================================================

# Which identity this process presents/delegates as — required, no
# sensible default for a Grantor (unlike identity_manager's own
# IDENTITY_AGENT_ID uses, which default to the coordinator). Pick a
# name that identifies what this Grantor is authority OVER, e.g.
# "grantor-mi1" for a facility, not a generic placeholder.
IDENTITY_AGENT_ID=grantor-mi1

GOVERNING_AUTHORITY_HOST=sofia.sparkle.example.com

# SAME values as identity_manager's own .env — this is the SAME shared
# keystore, never a separate one per Grantor.
IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey

# redis REQUIRED here — "memory" (the default if unset) means this
# process never finds the credential identity_manager cached when it
# issued this Grantor's Identity Credential.
IDENTITY_CREDENTIAL_CACHE_BACKEND=redis

# Issue #80: "redis" here too, same shared connection as above — this
# agent doesn't issue delegations to ITSELF, but the backend toggle is
# kept consistent with every other identity-aware service in this
# sample so a future Operational Credential this process ever needs to
# hold (e.g. presenting a delegated scope onward) persists across
# restarts instead of a fresh, empty, per-process store.
OPERATIONAL_CREDENTIAL_CACHE_BACKEND=redis

# SAME platform-wide status list identity_manager publishes to —
# Operational Credentials this agent issues share it rather than each
# Grantor getting its own separately-published list (a known
# simplification, see this sample's README).
IDENTITY_AUTHORITY_ID=sofia-authority
STATUS_LIST_REDIS_URL=redis://localhost:6379
STATUS_LIST_PUBLISH_URL=https://sofia.sparkle.example.com/identity/status-list

# ── Issue #80 — identity_verifier on THIS agent's own endpoint ─────────────
# This Grantor is called exclusively by the coordinator via
# ContextualSecureRemoteA2aAgent — require a verified presentation from
# it (not just the API key above), same posture as identity_manager's
# own endpoint. false (default): identity_verifier=None, no behavior
# change. true: the coordinator's identity must already be bootstrapped
# (bootstrap_coordinator_identity.py), otherwise every presentation is
# rejected ("unknown or untrusted holder").
REQUIRE_IDENTITY_PRESENTATION=false

# SAME Postgres "sofia" database as identity_manager's own IDENTITY_PG_DSN
# — needed to resolve the coordinator's (or any other caller's) DID
# Document generically via holder_key_resolver.
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
IDENTITY_PG_DID_TABLE=sf_identity_did_documents
