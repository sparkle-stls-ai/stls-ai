# =============================================================================
# .env for sofia_redis_agent (agent_redis.py / server.py)
# =============================================================================
# No example file existed for this service before issue #80 — created
# now, same placeholder style as identity_manager/env.example and
# coordinator/env.example (no real secrets).
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8013
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth Loader Backend ──────────────────────────────────────────────────────
AUTH_LOADER_BACKEND=postgres       # static | file | postgres
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents
SF_HEARTBEAT_INTERVAL=120
SF_LIVENESS_THRESHOLD=360

# ── Redis (cache for the loader above; ALSO the Redis instance this agent
# itself inspects/manages on behalf of the coordinator) ─────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:mypassword@localhost:6379/0
AUTH_KM_USE_REDIS=true
AUTH_KEY_TTL=3600
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REFRESH_INTERVAL=300

# ── LLM ────────────────────────────────────────────────────────────────────
AGENT_MODEL="gemini-3.5-flash"
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Arqit Sparkle SKA / session provider ────────────────────────────────────
KEY_SESSION_PORT=8081
KEY_PROVIDER_NAME=pqc


# =============================================================================
# Issue #80 — identity_verifier on THIS agent's own endpoint
# =============================================================================
# This agent is called exclusively by the coordinator via
# ContextualSecureRemoteA2aAgent (agent_coordinator.py) — require a
# verified DID/VC presentation from it (not just the API key above),
# same posture as identity_manager's own endpoint.
#
# false (default): identity_verifier=None, no behavior change.
# true: requires a valid VerifiablePresentation from the coordinator —
# run bootstrap_coordinator_identity.py first (or ask sofia_identity_agent
# in chat), otherwise every presentation is rejected ("unknown or
# untrusted holder"). NOTE: the plain, unencrypted /agents/sofia-redis/
# endpoint stays reachable regardless (issue #80 point 4 would close
# it once a verifier is configured — left enabled for now).
REQUIRE_IDENTITY_PRESENTATION=false

# ── Governing Authority — whose key this verifier trusts to have signed
# every caller's Identity Credential. SAME values as identity_manager's
# own .env — this is the SAME shared authority, never a separate one
# per sub-agent.
GOVERNING_AUTHORITY_DID=did:web:sofia.sparkle.example.com
GOVERNING_AUTHORITY_HOST=sofia.sparkle.example.com
GOVERNING_AUTHORITY_AGENT_ID=governing-authority

# SAME values as identity_manager's own .env — the verifier resolves
# the Governing Authority's REAL, already-bootstrapped key from this
# keystore; pointing it anywhere else (or leaving it on the "memory"
# default) would make it mint a brand-new, unrelated key instead and
# every presentation would fail "unknown or untrusted holder".
IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey

# SAME Postgres "sofia" database as identity_manager's own IDENTITY_PG_DSN
# — needed to resolve the coordinator's (or any other caller's) DID
# Document generically via holder_key_resolver.
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
IDENTITY_PG_DID_TABLE=sf_identity_did_documents

# Issue #80: this agent has no Requestor role today (it never presents
# its own identity to anyone), so neither cache is on this process's
# hot path yet — kept "redis" anyway for consistency with every other
# identity-aware service in this sample, so a future Requestor role
# added to this agent persists across restarts instead of a fresh,
# empty, per-process store. No dedicated URL needed: falls back to
# STATUS_LIST_REDIS_URL below if unset.
IDENTITY_CREDENTIAL_CACHE_BACKEND=redis
OPERATIONAL_CREDENTIAL_CACHE_BACKEND=redis
STATUS_LIST_REDIS_URL=redis://localhost:6379
