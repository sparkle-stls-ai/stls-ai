# =============================================================================
# .env for Operator B's identity_manager (agent_identity.py / tools_identity.py)
# =============================================================================
# Standalone identity-federation example (see samples/server/sofia-admin's
# own README) — same codebase as samples/server/sofia-admin/server/identity_manager,
# a second deployment configured as a DIFFERENT Governing Authority
# (b.example.com instead of sofia.sparkle.example.com), to exercise
# cross-platform trust-anchor federation and delegation (issues #48/#51).
# No env.example existed for this deployment before — a real gap, found
# while provisioning a Grantor agent under it (issue #51).
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8015
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth Loader Backend ──────────────────────────────────────────────────────
AUTH_LOADER_BACKEND=postgres       # static | file | postgres

# ── PostgresLoader ───────────────────────────────────────────────────────────
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents

# ── Redis (cache for the loader above) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
AUTH_KM_USE_REDIS=true
AUTH_KEY_TTL=3600
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REFRESH_INTERVAL=300

# ── LLM ────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── a2a secure provider ──────────────────────────────────────────────────────
KEY_SESSION_PORT=8081
KEY_PROVIDER_NAME=pqc


# =============================================================================
# Operator B's own Governing Authority — identical shape to Sparkle's own
# identity_manager/env.example, different values (a different operator).
# =============================================================================

GOVERNING_AUTHORITY_DID=did:web:b.example.com
GOVERNING_AUTHORITY_HOST=b.example.com
GOVERNING_AUTHORITY_AGENT_ID=governing-authority
IDENTITY_AUTHORITY_ID=operatore-b-authority
STATUS_LIST_PUBLISH_URL=http://localhost:8001/identity/status-list

# ── Identity Keystore ─────────────────────────────────────────────────────────
IDENTITY_KEYSTORE_BACKEND=redis

# /1, not /0 — a separate Redis DB from Sparkle's own (which uses the
# default, suffix-less REDIS_URL above), not just a different namespace,
# so an agent_id that happens to collide between the two platforms can
# never actually collide in storage.
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379/1
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey

# issue #45/#51: REQUIRED for any cached credential (issued here) to be
# visible to a SEPARATE process reading from the SAME cache — e.g. a
# Grantor agent deployed under this operator (operator-b/grantor_agent/,
# issue #51). "memory" (the default if unset) means this would only
# ever be visible within the short-lived provisioning script's own
# process, never to the actual long-running Grantor agent — the exact
# bug class issue #45 already found and fixed for Sparkle's own
# coordinator, found again here while wiring the federation scenario.
IDENTITY_CREDENTIAL_CACHE_BACKEND=redis

# ── Status List ───────────────────────────────────────────────────────────────
STATUS_LIST_REDIS_URL=redis://localhost:6379/1

# ── Postgres — DID Document store ────────────────────────────────────────────
# Same "sofia" database/instance as Sparkle — isolated via table prefix
# (opb_ instead of sf_), not a dedicated database. Tables self-create on
# first use (CREATE TABLE IF NOT EXISTS).
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
IDENTITY_PG_DID_TABLE=opb_identity_did_documents
IDENTITY_PG_CREDENTIAL_LOG_TABLE=opb_identity_credential_log

# ── Trust Anchor Registry — DELIBERATELY the SAME table as Sparkle's own ─────
# Operator B has no registry of its own (Option A: one centralized
# registry in the federation, Sparkle's) — but onboard_trust_anchor/
# list_trust_anchors/revoke_trust_anchor remain among this agent's tools
# (same code, no per-deployment way to exclude them). Pointed explicitly
# at Sparkle's real table, rather than left at the package default, so
# it never lands on a phantom table on the same instance — in practice,
# these three tools shouldn't be used from this agent.
TRUST_REGISTRY_PG_TABLE=sf_identity_trust_anchors
