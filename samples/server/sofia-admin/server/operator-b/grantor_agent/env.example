# =============================================================================
# .env for a Grantor agent deployed under Operator B (issue #51's
# inter-operator scenario)
# =============================================================================
# Second deployment of the SAME generic code as
# samples/server/sofia-admin/server/grantor_agent — nothing in that code
# is Sparkle-specific. This copy represents a Grantor with authority
# over part of Operator B's own network, able to delegate to agents on
# ANOTHER federated platform (e.g. one of Sparkle's), the same
# cross-platform shape #48 already tested for VALIDATING an incoming
# delegation — this is the issuing side of that same federation.
# =============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8017
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth Loader Backend — protects THIS agent's own endpoint ────────────────
AUTH_LOADER_BACKEND=postgres
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents
SF_HEARTBEAT_INTERVAL=120
SF_LIVENESS_THRESHOLD=360

# ── Redis (cache for the loader above) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
AUTH_KM_USE_REDIS=true
AUTH_KEY_TTL=3600
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REFRESH_INTERVAL=300

# ── LLM ────────────────────────────────────────────────────────────────────
AGENT_MODEL="gemini-3.5-flash"
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── a2a secure provider ──────────────────────────────────────────────────────
KEY_SESSION_PORT=8081
KEY_PROVIDER_NAME=pqc


# =============================================================================
# This Grantor's own identity — must already be provisioned by
# operator-b/identity_manager/bootstrap_grantor_agent_identity.py
# (same script as Sparkle's own, run from operator-b/identity_manager/
# instead — it's the SAME code, a different deployment's .env is what
# makes it provision under Operator B's own Governing Authority).
# =============================================================================

IDENTITY_AGENT_ID=grantor-b-segment

# b.example.com, NOT sofia.sparkle.example.com — this Grantor's
# identity is rooted in Operator B's own Governing Authority.
GOVERNING_AUTHORITY_HOST=b.example.com

# SAME values as operator-b/identity_manager's own .env — this is the
# SAME shared keystore for that platform, /1 not /0 (Sparkle's own).
IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379/1
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey

# redis REQUIRED — see the same note in
# operator-b/identity_manager/env.example (issue #45's bug class).
IDENTITY_CREDENTIAL_CACHE_BACKEND=redis

# SAME platform-wide status list operator-b/identity_manager publishes
# to (port 8001, its own identity_bridge — NOT Sparkle's port 8000).
IDENTITY_AUTHORITY_ID=operatore-b-authority
STATUS_LIST_REDIS_URL=redis://localhost:6379/1
STATUS_LIST_PUBLISH_URL=http://localhost:8001/identity/status-list
