# =============================================================================
# .env.identity_bridge — configurazione per run_identity_bridge.py
# =============================================================================
# File dedicato, separato dal .env dell'agente conversazionale
# (agent_identity.py / tools_identity.py) — i due processi restano
# indipendenti anche se girano nello stesso repo/directory.
#
# Sottoinsieme scoped di .env.example (il file completo del package
# stls-identity) — solo le variabili che il bridge legge davvero.
# =============================================================================

# ── Identità dell'Authority servita da questo bridge ─────────────────────────────

# DID della Governing Authority — va dentro StatusListCredential.issuer
# ad ogni pubblicazione periodica.
GOVERNING_AUTHORITY_DID=did:web:sofia.sparkle.example.com

# agent_id sotto cui è pubblicato il DID Document della Governing Authority
# stessa — GET /.well-known/did.json lo risolve da qui.
GOVERNING_AUTHORITY_AGENT_ID=governing-authority

# authority_id sotto cui è cachata la status list pubblicata — deve
# corrispondere a quello usato da tools_identity.py (IDENTITY_AUTHORITY_ID)
# e da IdentityManager, altrimenti il bridge pubblicherebbe la bitstring
# di un'Authority diversa da quella su cui l'agente sta scrivendo le revoche.
IDENTITY_AUTHORITY_ID=sofia-authority

# URL pubblico che finisce dentro ogni StatusListCredential.id pubblicato
# — deve combaciare con quello usato da tools_identity.py
# (STATUS_LIST_PUBLISH_URL) quando emette una credenziale, altrimenti
# CredentialStatus.statusListCredential punterebbe a un URL diverso da
# quello che questo bridge serve davvero.
STATUS_LIST_PUBLISH_URL=https://sofia.sparkle.example.com/identity/status-list


# ── Redis — bitstring di revoca (StatusListManager, stessa di tools_identity.py) ─
# Deve essere la STESSA connessione/authority_id di IDENTITY_AUTHORITY_ID
# sopra — è la bitstring che IdentityManager.revoke() aggiorna, questo
# bridge la legge e la ripubblica, non ne tiene una copia indipendente.
STATUS_LIST_REDIS_URL=redis://localhost:6379

# Ogni quanti secondi ripubblicare la status list nella cache Postgres.
# Deve restare SOTTO l'MRI (5 minuti / 300s nel codice, verifier.py) —
# altrimenti un verificatore esterno può considerarla stale secondo le
# sue stesse regole, anche appena ripubblicata. Pubblicata anche una
# volta subito all'avvio, non solo al primo giro del timer.
STATUS_LIST_REFRESH_INTERVAL_SECONDS=60


# ── Postgres — DID Document store + status list cache ────────────────────────────
# Stesso IDENTITY_PG_DSN dell'agente (stesso database "sofia", tabelle
# separate) — il bridge legge quello che l'agente scrive, non serve un
# database dedicato. Le tabelle si creano da sole al primo avvio
# (CREATE TABLE IF NOT EXISTS in _ensure_schema), nessuna migrazione manuale.
IDENTITY_PG_DSN=postgresql://<user>:<password>@<host>:5432/sofia
IDENTITY_PG_DID_TABLE=sf_identity_did_documents
IDENTITY_PG_STATUS_LIST_TABLE=sf_identity_status_list_cache


# ── Identity Keystore — DEVE combaciare ESATTAMENTE con .env.identity_agent ──────
GOVERNING_AUTHORITY_HOST=sofia.sparkle.example.com  

IDENTITY_KEYSTORE_BACKEND=redis                       
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379   
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey  

# ── Server HTTP ────────────────────────────────────────────────────────────────
IDENTITY_BRIDGE_PORT=8000
