# server_ms_2 — the other of the two client/server pairs in the
# multi-server test. Change only KEY_PROVIDER_NAME to test base / pqc /
# arqit_py: the rest of this file (ARQIT_PY_*) is only read when it's
# actually needed.
#
# Copy to .env and fill in GOOGLE_API_KEY.

KEY_PROVIDER_NAME=pqc

PORT=8102
BASE_URL=http://localhost:8102
AGENT_PATH=/agents/server-ms-2/secure-a2a
SERVER_LABEL=server-ms-2

# Only needed for KEY_PROVIDER_NAME=arqit_py. Absolute path so it is
# independent of the launch cwd (the config itself points at relative
# metadata/policy files, resolved against server.py's cwd, which it
# anchors to its own directory — see server.py).
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/samples/server/10_server_ms/server_ms_2/aq-sf-server-ms-2.json
ARQIT_PY_TRANSPORT=socket

# Only needed when KEY_PROVIDER_NAME=pqc or base is paired with ADK
# agents that call Gemini.
GOOGLE_API_KEY=
