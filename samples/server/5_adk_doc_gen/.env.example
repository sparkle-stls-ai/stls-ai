# Copy to .env and fill in OPENAI_API_KEY / GOOGLE_API_KEY (and AUTH_PG_DSN's
# password if you enable Postgres-backed API key auth).

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8005
BASE_URL=http://localhost:${PORT}

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=360
TASK_STORE_CLEANUP_ENABLED=true
TASK_STORE_CLEANUP_INTERVAL=180

# ── Auth loader backend ───────────────────────────────────────────────────────
# Default loader used by ApiKeyManager.from_env(). server.py wires its own
# loader explicitly (see build_app()), so this variable isn't read directly
# by the server — it's here for documentation and for utility scripts that
# use from_env().
AUTH_LOADER_BACKEND=postgres       # static | file | postgres

# ── PostgresLoader ───────────────────────────────────────────────────────────
# Leave AUTH_PG_DSN empty to disable Postgres-backed API key auth (falls
# back to the legacy static AuthConfig).
AUTH_PG_DSN=postgresql://<user>:<password>@<host>:5432/<db>
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents       # default
SF_HEARTBEAT_INTERVAL=120       # 2 minutes
SF_LIVENESS_THRESHOLD=360       # 3x heartbeat = offline if missed for 6 min

# ── Redis (cache for all loaders) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Redis TLS (Azure Cache, GCP Memorystore with TLS):
# REDIS_URL=rediss://:<password>@my-instance.redis.cache.windows.net:6380
# Redis with authentication:
# REDIS_URL=redis://:<password>@localhost:6379/0

# Set to false to disable Redis (loader queried directly on every request)
AUTH_KM_USE_REDIS=true

# ── TTL and refresh ────────────────────────────────────────────────────────────
AUTH_KEY_TTL=3600              # Redis TTL for KeyRecords (seconds) — reloaded from the loader
AUTH_REFRESH_DISTRIBUTED=true  # default, enables the Redis lock
AUTH_REFRESH_INTERVAL=300      # every node tries every 5 min, only one wins
# AUTH_REFRESH_DISTRIBUTED=false  # disable for local development

# ── OpenAI key ───────────────────────────────────────────
OPENAI_API_KEY=
# ── Google key ───────────────────────────────────────────
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=eu
GOOGLE_GENAI_USE_VERTEXAI=TRUE
AGENT_MODEL="gemini-3.5-flash"
GOOGLE_API_KEY=

# ── Arqit Sparkle SKA ────────────────────────────────────────────
KEY_SESSION_PORT=8081
KEY_PROVIDER_NAME=arqit_py     # base | arqit_py | pqc — base needs no key-exchange sidecar

# Only needed for KEY_PROVIDER_NAME=arqit_py. Absolute path, independent of
# the launch cwd.
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/samples/server/5_adk_doc_gen/aq-sf-agent-server5.json
ARQIT_PY_TRANSPORT=socket      # or mqtt
