KEY_PROVIDER_NAME=pqc
PORT=8301

# Only needed for KEY_PROVIDER_NAME=arqit_py, and read by the Python
# sidecar process (launched separately — see the README), not by this
# script directly. ARQIT_SIDECAR_TOKEN_SERVER must match the token that
# sidecar process was started with (required — #17/#18 local socket
# authentication).
#
# Reuses samples/server/12_server_mcp_ms/server_mcp_ms_1's already-
# provisioned device (sf-node-mcp-server-ms-1) instead of a dedicated
# pair — provisioning a brand-new Arqit device identity isn't
# self-serviceable here. Swap for a dedicated pair if one gets
# provisioned later.
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-13-server-core.sock
ARQIT_SIDECAR_TOKEN_SERVER=some-shared-secret-1
ARQIT_PY_SERVER_CONFIG=/absolute/path/to/samples/server/12_server_mcp_ms/server_mcp_ms_1/aq-sf-node-mcp-server-ms-1.json
