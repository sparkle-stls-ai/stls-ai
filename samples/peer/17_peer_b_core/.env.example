PEER_NAME=peer-b
PORT=8502
PEER_URL=http://localhost:8501
INITIATE=0
KEY_PROVIDER_NAME=pqc

# See peer-a's .env.example for the full rationale. This peer's SERVER
# role sidecar runs in ARQIT_PY_DEVICE_ROLE=consumer too, fed by a
# separate device-agent owning pair1-server -- the counterpart paired
# with peer-a's CLIENT role (pair1-client). This peer's own CLIENT
# role uses pair2-client (owner sidecar, real negotiation) -- paired
# with peer-a's SERVER role (pair2-server).
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-17-peer-b-server.sock
ARQIT_SIDECAR_TOKEN_SERVER=peer-b-server-token
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-17-peer-b-client.sock
ARQIT_SIDECAR_TOKEN_CLIENT=peer-b-client-token
