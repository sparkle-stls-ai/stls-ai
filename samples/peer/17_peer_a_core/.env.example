PEER_NAME=peer-a
PORT=8501
PEER_URL=http://localhost:8502
INITIATE=1
KEY_PROVIDER_NAME=pqc

# Only needed for KEY_PROVIDER_NAME=arqit_py. Unlike 14_peer_a_core,
# this peer's SERVER role sidecar runs in ARQIT_PY_DEVICE_ROLE=consumer
# (set on the SIDECAR's own env when you launch it, never here) --
# fed by a separate, standalone arqit_device_agent.py process that
# owns pair2-server, this peer's SERVER-role device (issue #38). Its
# CLIENT role still needs a real owner sidecar (pair1-client) -- see
# the README for the full 6-process setup and why pair2/pair1 (not
# pair1/pair2) is the correct assignment.
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-17-peer-a-server.sock
ARQIT_SIDECAR_TOKEN_SERVER=peer-a-server-token
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-17-peer-a-client.sock
ARQIT_SIDECAR_TOKEN_CLIENT=peer-a-client-token
