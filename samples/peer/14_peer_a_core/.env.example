PEER_NAME=peer-a
PORT=8401
PEER_URL=http://localhost:8402
INITIATE=1
KEY_PROVIDER_NAME=pqc

# Only needed for KEY_PROVIDER_NAME=arqit_py. This peer plays BOTH
# roles (it's contacted AS a server, and it initiates AS a client), so
# it needs TWO sidecars — one per role, each with its own Arqit device
# identity. Reuses samples/server/12_server_mcp_ms's device pairs
# rather than dedicated identities — see the README for the full
# rationale, the exact sidecar launch commands, and WHY the SERVER role
# below uses device pair 2 (sf-node-mcp-server-ms-2), not pair 1: Arqit
# bilocation/P2P key agreement only works between two SPECIFIC
# pre-paired devices, and this peer's SERVER role is contacted by
# peer-b's CLIENT role, which uses sf-node-mcp-client-ms-2 — its paired
# counterpart.
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-14-peer-a-server.sock
ARQIT_SIDECAR_TOKEN_SERVER=peer-a-server-token
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-14-peer-a-client.sock
ARQIT_SIDECAR_TOKEN_CLIENT=peer-a-client-token
