PEER_NAME=peer-b
PORT=8402
PEER_URL=http://localhost:8401
INITIATE=0
KEY_PROVIDER_NAME=pqc

# See peer-a's .env.example for the full rationale. This peer's SERVER
# role uses sf-node-mcp-server-ms-1 (device pair 1) — the counterpart
# paired with peer-a's CLIENT role (sf-node-mcp-client-ms-1). Its
# CLIENT role uses sf-node-mcp-client-ms-2 (device pair 2) — paired
# with peer-a's SERVER role (sf-node-mcp-server-ms-2).
ARQIT_SIDECAR_SOCKET_SERVER=/tmp/stls-14-peer-b-server.sock
ARQIT_SIDECAR_TOKEN_SERVER=peer-b-server-token
ARQIT_SIDECAR_SOCKET_CLIENT=/tmp/stls-14-peer-b-client.sock
ARQIT_SIDECAR_TOKEN_CLIENT=peer-b-client-token
