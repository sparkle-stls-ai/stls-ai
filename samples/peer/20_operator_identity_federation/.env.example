# Shared by bootstrap_identities.py and run_demo.py (copy to .env at this
# sample's root; each subdirectory has its own .env.example for its own
# process-specific overrides).

# Required — StatusListManager has no in-memory variant; revocation in
# this demo's bonus step is real, not faked. redis://localhost:6379 is
# fine for a local `redis-server` or `docker run -p 6379:6379 redis`.
REDIS_URL=redis://localhost:6379

# Optional — leave unset (defaults to "memory", local to whichever
# process set it) for a zero-extra-infra run. Set to "redis" on all
# three to see the agents' own signing keys / cached credentials for
# real in redis-cli, under the stls:identity:* keys.
# IDENTITY_KEYSTORE_BACKEND=redis
# IDENTITY_CREDENTIAL_CACHE_BACKEND=redis
# OPERATIONAL_CREDENTIAL_CACHE_BACKEND=redis
