# =============================================================================
# stls-identity — example environment variables
# =============================================================================
# Copy to .env and adapt to your environment's values (dev/staging/prod).
# .env must NOT be committed — add it to .gitignore if not already there
# (consistent with the exclusion already in use for the proprietary Arqit
# wheels).
#
# tests/conftest.py loads .env automatically for local runs (via
# python-dotenv) — no need to `export` by hand before `pytest` anymore.
# Variables already exported at the shell/CI level still take priority.
# =============================================================================


# -----------------------------------------------------------------------------
# Identity Keystore — Ed25519 signing key persistence (keystore.py)
# -----------------------------------------------------------------------------
# NOT the same store as ArqitKeyStoreBase (stls-core): that one is for
# ephemeral session keys with a TTL, this one is for the agent's/authority's
# signing key, persistent, with no expiry.

# "memory" (default, dev/test — does not survive a restart) | "redis" (persistent)
IDENTITY_KEYSTORE_BACKEND=memory

# Only used if IDENTITY_KEYSTORE_BACKEND=redis
IDENTITY_KEYSTORE_REDIS_URL=redis://localhost:6379
IDENTITY_KEYSTORE_REDIS_NAMESPACE=stls:identity:signingkey

# For GCP production, consider a Secret Manager backend in place of
# Redis for this key (see the comment in keystore.py — not yet
# implemented, it's the natural extension point of IdentityKeystoreBase).


# -----------------------------------------------------------------------------
# Status List — revocation bitstring (status.py)
# -----------------------------------------------------------------------------
# StatusListManager receives an already-constructed redis.Redis client
# (it does not read env vars on its own) — this variable is for the
# application code that instantiates it, kept consistent with the rest
# of stls-core's style.

STATUS_LIST_REDIS_URL=redis://localhost:6379

# Maximum freshness allowed for the status list before the Sentinel
# rejects for fail-closed (see verifier.py — MRI, Maximum Revocation
# Interval). The code default is 300s (5 minutes); listed here only to
# document the constraint, not yet read from env in the current code.
# IDENTITY_STATUS_LIST_MRI_SECONDS=300


# -----------------------------------------------------------------------------
# Postgres — DID Document store + status list cache (postgres_store.py)
# -----------------------------------------------------------------------------
# The tables create themselves on first use in the tests (see the DDL in
# postgres_store.py, also reusable for a real migration in production —
# it does not run automatically against the production DB).

IDENTITY_PG_DSN=postgresql://user:password@localhost:5432/stls_identity

# Table names — usually no need to touch these, present for consistency
# with the SF_API_KEYS_TABLE pattern already used by PostgresLoader in
# stls-core.
IDENTITY_PG_DID_TABLE=stls_identity_did_documents
IDENTITY_PG_STATUS_LIST_TABLE=stls_identity_status_list_cache


# -----------------------------------------------------------------------------
# Governing Authority — issuer identity (issuer.py / bridge.py)
# -----------------------------------------------------------------------------
GOVERNING_AUTHORITY_DID=did:web:sofia.spk.example.com
GOVERNING_AUTHORITY_HOST=sofia.spk.example.com

# agent_id under which the Governing Authority's own DID Document is
# stored in the DID store — bridge.py uses it for GET /.well-known/did.json
GOVERNING_AUTHORITY_AGENT_ID=governing-authority

# authority_id under which the published status list is cached — must
# match the one passed to StatusListManager(authority_id=...)
IDENTITY_AUTHORITY_ID=sofia-authority

# Public URL where the StatusListCredential will be published — goes
# into every CredentialStatus.status_list_credential issued by IdentityManager.
STATUS_LIST_PUBLISH_URL=https://sofia.spk.example.com/identity/status-list

# Default validity of a NetworkAuthorityCredential, in days.
# The code default is 90 (issuer.py: DEFAULT_VALIDITY) — not yet read
# from env, listed here as a future configuration point.
# IDENTITY_CREDENTIAL_VALIDITY_DAYS=90


# -----------------------------------------------------------------------------
# Tests only — DELIBERATELY separate from the production DSNs above.
# -----------------------------------------------------------------------------
# The tests TRUNCATE the tables/bitstrings they touch on every run.
# Accidentally pointing them at IDENTITY_PG_DSN or STATUS_LIST_REDIS_URL
# for dev/staging would wipe real data without you asking for it.
# Use a dedicated db/namespace instead, as below.

IDENTITY_TEST_PG_DSN=postgresql://postgres:postgres@localhost:5432/stls_identity_test
STATUS_LIST_TEST_REDIS_URL=redis://localhost:6379/15


# -----------------------------------------------------------------------------
# Reference — variables that already exist in stls-core (do NOT duplicate
# them here; they live in stls-core's own .env, listed only for context)
# -----------------------------------------------------------------------------
# KEY_PROVIDER_NAME=base
# SESSION_CACHE_BACKEND=memory
# AUTH_LOADER_BACKEND=static
# AUTH_KEY_TTL=3600
# AUTH_REFRESH_INTERVAL=300
# AUTH_PG_DSN=postgresql://user:password@localhost:5432/stls_core
