# =============================================================================
# stls-mcp — Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# NEVER commit the real .env file to the repository.
#
# stls-mcp depends on stls-core: the Key Provider, Session Cache, Auth,
# Redis and PostgreSQL variables are the same as stls-core's (see also
# ../stls-core/.env.example for a detailed description of each one).
# They are repeated here for convenience, plus the MCP server-specific
# variables.
#
# Sections:
#   1. MCP Server (host, port, path)
#   2. Key Provider (shared with stls-core)
#   3. Arqit SKA-Platform (only if KEY_PROVIDER_NAME=arqit_py)
#   4. Session Cache (shared with stls-core)
#   5. Auth — API Key Manager (optional, shared with stls-core)
#   6. Redis (optional)
#   7. PostgreSQL (only if AUTH_LOADER_BACKEND=postgres)
#   8. Symmetric Key Store
#   9. Session Store
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MCP SERVER
# -----------------------------------------------------------------------------

# Bind host for the uvicorn server.
# "127.0.0.1" for local development / Claude Desktop via tunnel,
# "0.0.0.0" for exposure on a network/container.
MCP_SERVER_HOST=127.0.0.1

# Listening port for the server.
MCP_SERVER_PORT=8765

# Path of the standard MCP endpoint, generated and managed entirely by the
# official SDK (FastMCP streamable_http_path). Leave unchanged unless you
# have specific upstream routing needs (reverse proxy, etc.).
MCP_PLAIN_PATH=/mcp

# Path of the STLS encrypted MCP endpoint.
MCP_STLS_PATH=/mcp-stls

# Hosts allowed by the DNS-rebinding protection built into the MCP SDK
# (TransportSecuritySettings.allowed_hosts), comma-separated.
# Required even for local development: without an explicit host in this
# list, the SDK rejects even requests from 127.0.0.1/localhost with
# 421 "Invalid Host header". In production, set the real public domain
# (e.g. mcp.example.com) instead of leaving the local wildcards.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*


# -----------------------------------------------------------------------------
# 2. KEY PROVIDER (shared with stls-core)
# -----------------------------------------------------------------------------

# Active provider: "base" (dev/test, fixed key) | "arqit_py" (production) | pqc
KEY_PROVIDER_NAME=base

# Port of the key session server (used by KeySessionProviderFactory on the SERVER side)
KEY_SESSION_PORT=8091


# -----------------------------------------------------------------------------
# 3. ARQIT SKA-PLATFORM (only if KEY_PROVIDER_NAME=arqit_py)
# -----------------------------------------------------------------------------

# Path to the Arqit client (initiator) JSON configuration file
ARQIT_PY_CLIENT_CONFIG=

# Path to the Arqit server (receiver) JSON configuration file
ARQIT_PY_SERVER_CONFIG=

# Transport for Arqit peering: "socket" (default, LAN) | "mqtt" (WAN/NAT)
ARQIT_PY_TRANSPORT=socket


# -----------------------------------------------------------------------------
# 4. SESSION CACHE (shared with stls-core)
# -----------------------------------------------------------------------------

# Maximum number of active STLS sessions in the cache (LRU eviction beyond this limit).
# Shared between the handshake endpoint and the encrypted /mcp-stls middleware.
STLS_SESSION_CACHE_MAX=256

# Session idle TTL in seconds (lazy expiry on next access)
STLS_SESSION_TTL=3600


# -----------------------------------------------------------------------------
# 5. AUTH — API KEY MANAGER (optional)
# -----------------------------------------------------------------------------
# Not required for the base flow: the STLS handshake already authenticates
# via proof-of-key-possession. This section only matters if you want to add
# an extra API key authentication layer on top of the handshake (e.g. to
# restrict which client_ids may request a handshake).

# If set to true, authenticated access is enforced on every request.
AUTH_ENABLED=true

# Loader backend for API keys: "static" | "file" | "postgres"
AUTH_LOADER_BACKEND=static

# Path to the YAML/JSON API keys file (only if AUTH_LOADER_BACKEND=file)
AUTH_KEYS_FILE=

# TTL in seconds for KeyRecords in the Redis cache (default 3600)
AUTH_KEY_TTL=3600

# Interval in seconds for the BackgroundRefresher (default 300)
AUTH_REFRESH_INTERVAL=300


# -----------------------------------------------------------------------------
# 6. REDIS (optional — required only if AUTH_LOADER_BACKEND=file or postgres)
# -----------------------------------------------------------------------------
# Extra install: uv pip install -e ".[redis]"
# If AUTH_LOADER_BACKEND=static (default), Redis is never contacted.

REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=stls


# -----------------------------------------------------------------------------
# 7. POSTGRESQL (only if AUTH_LOADER_BACKEND=postgres)
# -----------------------------------------------------------------------------

# asyncpg DSN for the PostgresLoader
# Format: postgresql://user:password@host:5432/dbname
AUTH_PG_DSN=

# -----------------------------------------------------------------------------
# 8. SYMMETRIC KEY STORE
# -----------------------------------------------------------------------------
KEY_STORE_BACKEND=memory             # memory (default) | redis
KEY_STORE_REDIS_URL=redis://localhost:6379
KEY_STORE_REDIS_NAMESPACE=default
KEY_STORE_PENDING_TTL=300            # seconds, key not yet delivered
KEY_STORE_SESSION_TTL=3600           # seconds, idle timeout for a key in use
KEY_STORE_POLL_INTERVAL=0.3          # seconds, wait_for_new_key polling interval (Redis)

# -----------------------------------------------------------------------------
# 9. SESSION STORE
# -----------------------------------------------------------------------------
SESSION_CACHE_BACKEND=memory          # memory (default) | redis
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc # Redis prefix, separate from stls:ks:*
SESSION_CACHE_TTL=3600                # idle timeout in seconds
