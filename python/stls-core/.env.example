# =============================================================================
# stls-core — Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# NEVER commit the real .env file to the repository.
#
# Sections:
#   1. Key Provider
#   2. Arqit SKA-Platform (only if KEY_PROVIDER_NAME=arqit_py)
#   3. Session Cache
#   4. Auth — API Key Manager
#   5. Redis
#   6. PostgreSQL (only if AUTH_LOADER_BACKEND=postgres)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KEY PROVIDER
# -----------------------------------------------------------------------------

# Active provider: "base" (dev/test, fixed key) | "arqit_py" (production)
KEY_PROVIDER_NAME=base

# Port of the key session server (used by KeySessionProviderFactory on the SERVER side)
KEY_SESSION_PORT=8091


# -----------------------------------------------------------------------------
# 2. ARQIT SKA-PLATFORM (only if KEY_PROVIDER_NAME=arqit_py)
# -----------------------------------------------------------------------------

# Path to the Arqit client (initiator) JSON configuration file
# Example: /opt/arqit/config/client_config.json
ARQIT_PY_CLIENT_CONFIG=

# Path to the Arqit server (receiver) JSON configuration file
# Example: /opt/arqit/config/server_config.json
ARQIT_PY_SERVER_CONFIG=

# Transport for Arqit peering: "socket" (default, LAN) | "mqtt" (WAN/NAT)
ARQIT_PY_TRANSPORT=socket


# -----------------------------------------------------------------------------
# 3. SESSION CACHE
# -----------------------------------------------------------------------------

# Maximum number of active STLS sessions in the cache (LRU eviction beyond this limit)
STLS_SESSION_CACHE_MAX=256

# Session idle TTL in seconds (sessions not accessed for more than N seconds
# are removed on the next access — lazy expiry)
STLS_SESSION_TTL=3600


# -----------------------------------------------------------------------------
# 4. AUTH — API KEY MANAGER
# -----------------------------------------------------------------------------

# API key loader backend:
#   static   → in-memory keys defined in code (legacy AuthConfig)
#   file     → YAML/JSON file (AUTH_KEYS_FILE)
#   postgres → PostgreSQL database (AUTH_PG_DSN)
AUTH_LOADER_BACKEND=static

# Path to the YAML/JSON API keys file (used only if AUTH_LOADER_BACKEND=file)
# YAML format:
#   - key_id: <sha256_hex>
#     client_id: agent-weather
#     scopes: ["secure-a2a"]
#     endpoints: ["/secure-a2a"]
#     expires_at: "2027-01-01T00:00:00+00:00"
AUTH_KEYS_FILE=

# TTL in seconds for KeyRecords in the Redis cache (default 3600)
AUTH_KEY_TTL=3600

# Interval in seconds for the BackgroundRefresher (reloads keys from the loader, default 300)
AUTH_REFRESH_INTERVAL=300


# -----------------------------------------------------------------------------
# 5. REDIS
# -----------------------------------------------------------------------------

# Redis URL for RedisKeyCache (auth) and SessionCache (if enabled on Redis)
# Supported formats:
#   redis://localhost:6379/0          (local, no auth)
#   redis://:password@host:6379/0     (with password)
#   rediss://host:6380/0              (TLS — Azure Cache, GCP Memorystore TLS)
REDIS_URL=redis://localhost:6379/0

# Redis namespace for the API keys (default "stls")
# Use different namespaces if multiple STLS instances share the same Redis
# e.g. "stls-dev", "stls-prod"
REDIS_NAMESPACE=stls


# -----------------------------------------------------------------------------
# 6. POSTGRESQL (only if AUTH_LOADER_BACKEND=postgres)
# -----------------------------------------------------------------------------

# asyncpg DSN for the PostgresLoader
# Format: postgresql://user:password@host:5432/dbname
# GCP Cloud SQL (socket): postgresql:///dbname?host=/cloudsql/project:region:instance
AUTH_PG_DSN=

# -----------------------------------------------------------------------------
# 7. SYMMETRIC KEY STORE
# -----------------------------------------------------------------------------
KEY_STORE_BACKEND=memory             # memory (default) | redis
KEY_STORE_REDIS_URL=redis://localhost:6379
KEY_STORE_REDIS_NAMESPACE=default
KEY_STORE_PENDING_TTL=300            # seconds, key not yet delivered
KEY_STORE_SESSION_TTL=3600           # seconds, idle timeout for a key in use
KEY_STORE_POLL_INTERVAL=0.3          # seconds, wait_for_new_key polling interval (Redis)

-----------------------------------------------------------------------------
# 8. SESSION STORE
# -----------------------------------------------------------------------------
SESSION_CACHE_BACKEND=memory          # memory (default) | redis
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc # Redis prefix, separate from stls:ks:*
SESSION_CACHE_TTL=3600                # idle timeout in seconds

# -----------------------------------------------------------------------------
# 9. ENCRYPTION AT REST (Redis-backed caches, issue #20)
# -----------------------------------------------------------------------------
# Shared by SESSION_CACHE_BACKEND=redis and KEY_STORE_BACKEND=redis above
# (domain-separated via HKDF, so one KEK safely serves both). Unset
# (default): both fall back to storing their payload in the clear, as
# before this existed — a warning is logged once per process at startup.
# Generate with: openssl rand -base64 32
STLS_CORE_ATREST_KEY=
