# =============================================================================
# stls-core — Environment Variables Example
# =============================================================================
# Copia questo file in .env e modifica i valori per il tuo ambiente.
# NON committare mai il .env reale nel repository.
#
# Sezioni:
#   1. Key Provider
#   2. Arqit SKA-Platform (solo se KEY_PROVIDER_NAME=arqit_py)
#   3. Session Cache
#   4. Auth — API Key Manager
#   5. Redis
#   6. PostgreSQL (solo se AUTH_LOADER_BACKEND=postgres)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KEY PROVIDER
# -----------------------------------------------------------------------------

# Provider attivo: "base" (dev/test, chiave fissa) | "arqit_py" (produzione)
KEY_PROVIDER_NAME=base

# Porta del key session server (usata da KeySessionProviderFactory lato SERVER)
KEY_SESSION_PORT=8091


# -----------------------------------------------------------------------------
# 2. ARQIT SKA-PLATFORM (solo se KEY_PROVIDER_NAME=arqit_py)
# -----------------------------------------------------------------------------

# Path al file JSON di configurazione del client Arqit (initiator)
# Esempio: /opt/arqit/config/client_config.json
ARQIT_PY_CLIENT_CONFIG=

# Path al file JSON di configurazione del server Arqit (receiver)
# Esempio: /opt/arqit/config/server_config.json
ARQIT_PY_SERVER_CONFIG=

# Transport per il peering Arqit: "socket" (default, LAN) | "mqtt" (WAN/NAT)
ARQIT_PY_TRANSPORT=socket


# -----------------------------------------------------------------------------
# 3. SESSION CACHE
# -----------------------------------------------------------------------------

# Numero massimo di sessioni STLS attive in cache (LRU eviction oltre il limite)
STLS_SESSION_CACHE_MAX=256

# TTL inattività sessione in secondi (sessioni non accedute da più di N secondi
# vengono rimosse al prossimo accesso — lazy expiry)
STLS_SESSION_TTL=3600


# -----------------------------------------------------------------------------
# 4. AUTH — API KEY MANAGER
# -----------------------------------------------------------------------------

# Backend loader per le API key:
#   static   → chiavi in-memory definite nel codice (AuthConfig legacy)
#   file     → file YAML/JSON (AUTH_KEYS_FILE)
#   postgres → database PostgreSQL (AUTH_PG_DSN)
AUTH_LOADER_BACKEND=static

# Path al file YAML/JSON delle API key (usato solo se AUTH_LOADER_BACKEND=file)
# Formato YAML:
#   - key_id: <sha256_hex>
#     client_id: agent-weather
#     scopes: ["secure-a2a"]
#     endpoints: ["/secure-a2a"]
#     expires_at: "2027-01-01T00:00:00+00:00"
AUTH_KEYS_FILE=

# TTL in secondi per i KeyRecord in Redis cache (default 3600)
AUTH_KEY_TTL=3600

# Intervallo in secondi del BackgroundRefresher (reload chiavi dal loader, default 300)
AUTH_REFRESH_INTERVAL=300


# -----------------------------------------------------------------------------
# 5. REDIS
# -----------------------------------------------------------------------------

# URL Redis per RedisKeyCache (auth) e SessionCache (se abilitata su Redis)
# Formati supportati:
#   redis://localhost:6379/0          (locale, no auth)
#   redis://:password@host:6379/0     (con password)
#   rediss://host:6380/0              (TLS — Azure Cache, GCP Memorystore TLS)
REDIS_URL=redis://localhost:6379/0

# Namespace Redis per le API key (default "stls")
# Usare namespace diversi se più istanze STLS condividono lo stesso Redis
# es. "stls-dev", "stls-prod"
REDIS_NAMESPACE=stls


# -----------------------------------------------------------------------------
# 6. POSTGRESQL (solo se AUTH_LOADER_BACKEND=postgres)
# -----------------------------------------------------------------------------

# DSN asyncpg per il PostgresLoader
# Formato: postgresql://user:password@host:5432/dbname
# GCP Cloud SQL (socket): postgresql:///dbname?host=/cloudsql/project:region:instance
AUTH_PG_DSN=

# -----------------------------------------------------------------------------
# 7. KEYSTORE delle chiavi simmetriche 
# -----------------------------------------------------------------------------
KEY_STORE_BACKEND=memory             # memory (default) | redis
KEY_STORE_REDIS_URL=redis://localhost:6379
KEY_STORE_REDIS_NAMESPACE=default
KEY_STORE_PENDING_TTL=300            # secondi, chiave non ancora consegnata
KEY_STORE_SESSION_TTL=3600           # secondi, idle timeout chiave in uso
KEY_STORE_POLL_INTERVAL=0.3          # secondi, polling wait_for_new_key (Redis)

-----------------------------------------------------------------------------
# 8. KEYSTORE delle sessioni 
# -----------------------------------------------------------------------------
SESSION_CACHE_BACKEND=memory          # memory (default) | redis
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc # prefisso Redis, separato da stls:ks:*
SESSION_CACHE_TTL=3600                # idle timeout secondi