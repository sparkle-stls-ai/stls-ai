# ── Server ──────────────────────────────────────────────────────────────────
PORT=8001

# ── Task Store ───────────────────────────────────────────────────────────────
TASK_STORE_BACKEND=redis       # memory | redis
REDIS_KEY_PREFIX=stls
TASK_STORE_TTL_SECONDS=180

# ── Auth Loader Backend ──────────────────────────────────────────────────────
# Loader usato di default da ApiKeyManager.from_env().
# Nel multi_agent_km_server ogni agente usa il proprio loader esplicitamente,
# quindi questa variabile NON è usata direttamente dal server.
# È qui per documentazione e per script di utilità che usano from_env().
AUTH_LOADER_BACKEND=static       # static | file | postgres

# ── FileLoader ───────────────────────────────────────────────────────────────
AUTH_KEYS_FILE=api_keys.yaml     # path al file YAML/JSON delle chiavi

# ── PostgresLoader ───────────────────────────────────────────────────────────
# Lasciare vuoto per disabilitare Postgres (lc-agent userà AuthConfig legacy)
AUTH_PG_DSN=postgresql://stls_user:stls_pass@localhost:5432/stls_dev
SF_API_KEYS_TABLE=sf_api_keys
SF_AGENTS_TABLE=sf_agents       # default
SF_HEARTBEAT_INTERVAL=120       # 2 minuti
SF_LIVENESS_THRESHOLD=360       # 3x heartbeat = offline se manca per 6 mi

# ── Redis (cache per tutti i loader) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Redis TLS (Azure Cache, GCP Memorystore con TLS):
# REDIS_URL=rediss://:<password>@my-instance.redis.cache.windows.net:6380
# Redis con autenticazione:
# REDIS_URL=redis://:mypassword@localhost:6379/0

# Metti false per disabilitare Redis (loader interrogato direttamente ad ogni request)
AUTH_KM_USE_REDIS=true

# ── TTL e refresh ────────────────────────────────────────────────────────────
AUTH_KEY_TTL=3600              # TTL Redis per i KeyRecord (secondi) - il record viene ricaricato da loader
AUTH_REFRESH_DISTRIBUTED=true  # default, abilita lock Redis
AUTH_REFRESH_INTERVAL=300      # tutti i nodi tentano ogni 5 min, uno solo vince
# AUTH_REFRESH_DISTRIBUTED=false  # disabilita per sviluppo locale

# ── OpenAI Key ───────────────────────────────────────────
OPENAI_API_KEY=...
# ── Google Key ───────────────────────────────────────────
GOOGLE_API_KEY=...

# ── Key Provider Configuration ────────────────────────────────────────────
KEY_SESSION_PORT=8081         
KEY_PROVIDER_NAME=base  # base | arqit_py | pqc

ARQIT_PY_CLIENT_CONFIG=
ARQIT_PY_SERVER_CONFIG=
ARQIT_PY_TRANSPORT=socket  


# -- variabili d'ambiente per il test client
TEST_STATIC_KEY="stls-static_d53f0129094779c51a290e5985b9240294af79512870b8954c18cd108a93544c"
TEST_FILE_KEY="stls_adk_test_key_change_me_in_production"
TEST_PG_KEY="stls-pg_4617e56adff650106de50e49f1e1ba8196ab81aab67bc3dcb10cdc5acf118aac"
