# =============================================================================
# stls-mcp (Node.js) — Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# NEVER commit the real .env file to the repository.
#
# stls-mcp depends on stls-core: the Key Provider, Session Cache, Auth and
# Redis/PostgreSQL variables are the same as stls-core's. They are
# repeated here for convenience, plus the MCP server/test-script-specific
# variables.
#
# Sections:
#   1. MCP Server (host, port, path)
#   2. Key Provider (shared with stls-core)
#   3. Arqit sidecar (only if KEY_PROVIDER_NAME=arqit_py)
#   4. Session Cache (shared with stls-core)
#   5. Auth — demo static keys (tests/vault-server.ts) and stls-core Auth
#   6. Redis (optional)
#   7. PostgreSQL (only if AUTH_LOADER_BACKEND=postgres)
#   8. Test scripts (tests/vault-*.ts, tests/interop/*)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MCP SERVER
# -----------------------------------------------------------------------------

# Bind host for the example server (tests/vault-server.ts).
# "127.0.0.1" for local development, "0.0.0.0" for exposure on a
# network/container.
MCP_SERVER_HOST=127.0.0.1

# Listening port for the example server.
MCP_SERVER_PORT=8765

# Path of the standard MCP endpoint. Shared by both the server and
# client test scripts — must match on both sides.
MCP_PLAIN_PATH=/mcp

# Path of the STLS encrypted MCP endpoint.
MCP_STLS_PATH=/mcp-stls


# -----------------------------------------------------------------------------
# 2. KEY PROVIDER (shared with stls-core)
# -----------------------------------------------------------------------------

# Active provider: "base" (dev/test, fixed key) | "arqit_py" (production) | pqc
KEY_PROVIDER_NAME=base


# -----------------------------------------------------------------------------
# 3. ARQIT SIDECAR (only if KEY_PROVIDER_NAME=arqit_py)
# -----------------------------------------------------------------------------
# Unlike the Python port (which talks to the Arqit SKA-Platform™ SDK
# in-process), the Node port reaches it through a Python sidecar process
# over a Unix domain socket — see node/stls-core/src/providers/arqit-sidecar.ts.

# Socket path used by both roles if the role-specific variables below are
# not set.
ARQIT_SIDECAR_SOCKET=

# Role-specific socket paths (take priority over ARQIT_SIDECAR_SOCKET).
ARQIT_SIDECAR_SOCKET_SERVER=
ARQIT_SIDECAR_SOCKET_CLIENT=


# -----------------------------------------------------------------------------
# 4. SESSION CACHE (shared with stls-core)
# -----------------------------------------------------------------------------

# Maximum number of active STLS sessions in the cache (LRU eviction beyond this limit).
STLS_SESSION_CACHE_MAX=256

# Session idle TTL in seconds (lazy expiry on next access).
# SESSION_CACHE_TTL takes priority over STLS_SESSION_TTL if both are set.
STLS_SESSION_TTL=3600

# Backend for the session cache: "memory" (default) | "redis"
SESSION_CACHE_BACKEND=memory
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc


# -----------------------------------------------------------------------------
# 5. AUTH (optional)
# -----------------------------------------------------------------------------
# Not required for the base flow: the STLS handshake already authenticates
# via proof-of-key-possession.

# Demo static auth used by tests/vault-server.ts: if set to true, requires
# one of AUTH_API_KEYS (comma-separated) on both MCP_PLAIN_PATH and
# MCP_STLS_PATH. The handshake endpoints remain always open.
AUTH_ENABLED=true
AUTH_API_KEYS=

# Enterprise ApiKeyManager (stls-core/auth) — wired up the same way as
# the Python port's AUTH_LOADER_BACKEND, if your own server code passes
# an ApiKeyManager to createSecureMcpApp()/wrapWithAuth(). Not used by
# tests/vault-server.ts, which only wires the static AuthConfig above.
AUTH_LOADER_BACKEND=static
AUTH_KEYS_FILE=
AUTH_KEY_TTL=3600
AUTH_REFRESH_INTERVAL=300
AUTH_KM_USE_REDIS=true
AUTH_REFRESH_DISTRIBUTED=true
AUTH_REDIS_NS=


# -----------------------------------------------------------------------------
# 6. REDIS (optional — required only if AUTH_LOADER_BACKEND=file or postgres,
#    or SESSION_CACHE_BACKEND=redis)
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# 7. POSTGRESQL (only if AUTH_LOADER_BACKEND=postgres)
# -----------------------------------------------------------------------------

# DSN for the PostgresLoader
# Format: postgresql://user:password@host:5432/dbname
AUTH_PG_DSN=
SF_API_KEYS_TABLE=


# -----------------------------------------------------------------------------
# 8. TEST SCRIPTS (tests/vault-*.ts, tests/interop/*)
# -----------------------------------------------------------------------------

# Base URL the client test scripts (tests/vault-client.ts) connect to.
VAULT_CLIENT_TARGET_URL=http://127.0.0.1:8765

# Base URL used by tests/interop/plain-endpoint.smoke.ts.
VAULT_SERVER_URL=http://127.0.0.1:8765
