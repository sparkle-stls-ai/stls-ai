    "test:pqc-interop-step2": "tsx tests/interop/pqc-step2-node-verify.ts",
    "test:redis-interop-step1": "tsx tests/interop/redis-step1-node-put.ts",
    "test:redis-interop-step3": "tsx tests/interop/redis-step3-node-get.ts",
    "test:arqit-sidecar-smoke": "tsx tests/interop/arqit-sidecar.smoke.ts",
    "test:arqit-sidecar-guard-smoke": "tsx tests/interop/arqit-sidecar-guard.smoke.ts",
    "test:arqit-sidecar-real-live": "tsx tests/interop/arqit-sidecar-real.live.ts",
    "test:provider-factory-arqit-real-live": "tsx tests/interop/provider-factory-arqit-real.live.ts",
