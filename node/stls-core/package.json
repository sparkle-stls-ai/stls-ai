    "test:postgres-loader-smoke": "tsx tests/postgres-loader.smoke.ts",
    "test:postgres-loader-live": "tsx tests/postgres-loader.live.ts",
    "test:apikeymanager-postgres-live": "tsx tests/apikeymanager-postgres.live.ts"
