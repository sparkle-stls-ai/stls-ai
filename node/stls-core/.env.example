# =============================================================================
# stls-core (Node.js) — Environment Variables Example
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# NEVER commit the real .env file to the repository.
#
# Sections:
#   1. Key Provider
#   2. Arqit sidecar (only if KEY_PROVIDER_NAME=arqit_py)
#   3. Session Cache
#   4. Auth — API Key Manager
#   5. Redis
#   6. PostgreSQL (only if AUTH_LOADER_BACKEND=postgres)
#   7. Test scripts (tests/*.live.ts, tests/interop/*)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KEY PROVIDER
# -----------------------------------------------------------------------------

# Active provider: "base" (dev/test, fixed key) | "arqit_py" (production) | "pqc"
KEY_PROVIDER_NAME=base


# -----------------------------------------------------------------------------
# 2. ARQIT SIDECAR (only if KEY_PROVIDER_NAME=arqit_py)
# -----------------------------------------------------------------------------
# Unlike the Python port (which talks to the Arqit SKA-Platform™ SDK
# in-process), the Node port reaches it through a Python sidecar process
# over a Unix domain socket — see src/providers/arqit-sidecar.ts.
# There is no Node equivalent of Python's ARQIT_PY_CLIENT_CONFIG/
# ARQIT_PY_SERVER_CONFIG/ARQIT_PY_TRANSPORT: the sidecar process itself
# is configured with those, Node only needs the socket path below.

# Socket path used by both roles if the role-specific variables below are
# not set.
ARQIT_SIDECAR_SOCKET=

# Role-specific socket paths (take priority over ARQIT_SIDECAR_SOCKET).
ARQIT_SIDECAR_SOCKET_SERVER=
ARQIT_SIDECAR_SOCKET_CLIENT=

# Shared secret the sidecar requires before any RPC call other than
# "authenticate" (#17/#18 — local socket authentication; the sidecar
# process refuses to start without one set on its own side). Same
# priority rules as the socket paths above: the role-specific variables
# take priority over the flat one.
ARQIT_SIDECAR_TOKEN=
ARQIT_SIDECAR_TOKEN_SERVER=
ARQIT_SIDECAR_TOKEN_CLIENT=


# -----------------------------------------------------------------------------
# 3. SESSION CACHE
# -----------------------------------------------------------------------------

# Maximum number of active STLS sessions in the cache (LRU eviction beyond this limit)
STLS_SESSION_CACHE_MAX=256

# Session idle TTL in seconds (sessions not accessed for more than N seconds
# are removed on the next access — lazy expiry)
# SESSION_CACHE_TTL takes priority over STLS_SESSION_TTL if both are set.
STLS_SESSION_TTL=3600

# Backend for the session cache: "memory" (default) | "redis"
SESSION_CACHE_BACKEND=memory
SESSION_CACHE_REDIS_URL=redis://localhost:6379
SESSION_CACHE_REDIS_NAMESPACE=stls:sc


# -----------------------------------------------------------------------------
# 4. AUTH — API KEY MANAGER
# -----------------------------------------------------------------------------

# API key loader backend:
#   static   → in-memory keys defined in code (legacy AuthConfig)
#   file     → YAML/JSON file (AUTH_KEYS_FILE)
#   postgres → PostgreSQL database (AUTH_PG_DSN)
AUTH_LOADER_BACKEND=static

# Path to the YAML/JSON API keys file (used only if AUTH_LOADER_BACKEND=file)
# YAML format:
#   - key_id: <sha256_hex>
#     client_id: agent-weather
#     scopes: ["secure-a2a"]
#     endpoints: ["/secure-a2a"]
#     expires_at: "2027-01-01T00:00:00+00:00"
AUTH_KEYS_FILE=

# TTL in seconds for KeyRecords in the Redis cache (default 3600)
AUTH_KEY_TTL=3600

# Interval in seconds for the BackgroundRefresher (reloads keys from the loader, default 300)
AUTH_REFRESH_INTERVAL=300

# Enables the Redis cache for the ApiKeyManager (default true)
AUTH_KM_USE_REDIS=true

# Enables the distributed (Redis-locked) refresh across replicas (default true)
AUTH_REFRESH_DISTRIBUTED=true

# Redis namespace for the API keys (default "stls")
AUTH_REDIS_NS=


# -----------------------------------------------------------------------------
# 5. REDIS
# -----------------------------------------------------------------------------

# Redis URL for RedisKeyCache (auth) and SessionCache (if enabled on Redis)
# Supported formats:
#   redis://localhost:6379/0          (local, no auth)
#   redis://:password@host:6379/0     (with password)
#   rediss://host:6380/0              (TLS — Azure Cache, GCP Memorystore TLS)
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# 6. POSTGRESQL (only if AUTH_LOADER_BACKEND=postgres)
# -----------------------------------------------------------------------------

# DSN for the PostgresLoader
# Format: postgresql://user:password@host:5432/dbname
AUTH_PG_DSN=
SF_API_KEYS_TABLE=


# -----------------------------------------------------------------------------
# 7. TEST SCRIPTS (tests/*.live.ts, tests/interop/*)
# -----------------------------------------------------------------------------

# Redis URL used by the live/interop test scripts (separate from REDIS_URL
# so tests can point at a throwaway Redis instance).
TEST_REDIS_URL=redis://localhost:6399

# Number of concurrent clients for tests/interop/arqit-sidecar-real.live.ts
# (default 1).
ARQIT_N_CLIENTS=1
